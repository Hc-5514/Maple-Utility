# === Database ===
DB_PASSWORD=
DB_PORT=5432
DATABASE_URL=postgresql://maple_user:<DB_PASSWORD>@localhost:5432/maple

# === Local PostgreSQL tests ===
# infra/scripts/test-postgres.sh init으로 .env.test.local 생성
# 테스트 프로세스 전용 설정 (애플리케이션 DB와 분리)
FLYWAY_TEST_URL=
FLYWAY_TEST_USER=
FLYWAY_TEST_PASSWORD=

# === Redis ===
REDIS_PORT=6379

# === Application ===
APP_PORT=8080
APP_IMAGE=ghcr.io/<owner>/<image>:<tag>
APP_CORS_ALLOWED_ORIGINS=https://<frontend-domain>,http://localhost:3000

# === JWT ===
JWT_SECRET=

# === Kakao OAuth ===
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://<backend-domain>/api/v1/auth/kakao/callback
KAKAO_TOKEN_URI=https://kauth.kakao.com/oauth/token
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me

# === Nexon Open API ===
NEXON_API_KEY_SECRET=
NEXON_CHARACTER_LIST_URI=https://open.api.nexon.com/maplestory/v1/character/list
NEXON_CHARACTER_BASIC_URI=https://open.api.nexon.com/maplestory/v1/character/basic
NEXON_CHARACTER_SCHEDULER_URI=https://open.api.nexon.com/maplestory/v1/scheduler/character-state

# === Nginx / SSL ===
SERVER_NAME=<backend-domain>
LETSENCRYPT_EMAIL=
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# === Deploy / Backup ===
DEPLOY_DIR=/opt/maple-utility
BACKUP_DIR=/backups

# === Cloudflare R2 Backup ===
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=maple-utility-backup
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
