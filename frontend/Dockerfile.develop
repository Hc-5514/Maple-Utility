FROM node:22-bookworm-slim AS build
WORKDIR /workspace/frontend
RUN corepack enable && corepack prepare pnpm@11.13.0 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN printf "allowBuilds:\n  esbuild: true\n" > pnpm-workspace.yaml && pnpm install --frozen-lockfile
COPY frontend/ ./
ARG KAKAO_CLIENT_ID
ENV VITE_API_BASE_URL=/api/v1 \
    VITE_USE_MOCK=false \
    VITE_REDIRECT_URI=http://localhost:3000/auth/callback \
    VITE_KAKAO_CLIENT_ID=${KAKAO_CLIENT_ID}
RUN test -n "$VITE_KAKAO_CLIENT_ID" && pnpm build

FROM nginx:1.27-alpine
COPY infra/nginx/develop.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/frontend/dist/ /usr/share/nginx/html/
